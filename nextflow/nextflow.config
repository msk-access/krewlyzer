params {
    // Pipeline Options
    samplesheet = null  // Required: CSV with sample info
    help = false        // Display help message
    outdir = './results'
    queue_size = 100    // Max concurrent SLURM jobs (also used to derive FILTER_MAF maxForks)
    ref = null          // Required
    targets = null      // Optional global targets
    
    // Mode Selection
    use_runall = true         // true = unified run-all (default), false = tool-level
    
    // Genome Build & Correction
    genome = 'hg19'           // Genome build (hg19/hg38)
    gc_correct = true         // Enable GC correction
    pon_model = null          // Optional global PON model path
    pon_variant = 'all_unique'  // PON variant: 'all_unique' (default) or 'duplex'
    
    // Assay-based asset resolution
    asset_dir = null          // Base directory for PON/targets lookup by assay
                              // Structure: {asset_dir}/pon/{assay}.pon.parquet
                              //            {asset_dir}/targets/{assay}_targets.bed
    
    // Panel-specific options
    bait_padding = 50         // Bait edge padding for WPS (bp)
    wps_anchors = null        // WPS anchors BED (auto-loaded if not specified)
    wps_background = null     // WPS background Alu BED (auto-loaded if not specified)
    
    // Filters & Algorithm Settings
    mapq = 20
    minlen = 65
    maxlen = 1000             // Extended FSD range (default: 1000bp)
    skip_duplicates = true
    require_proper_pair = false   // Duplex BAMs often lack proper-pair flags
    duplex = true             // Enable duplex weighting for mFSD (graceful fallback)
    min_baseq = 20            // Minimum base quality for mFSD variant calling (--min-baseq)
    exclude_regions = ''
    threads = 8

    // Region Entropy Toggles
    no_tfbs = false           // Disable TFBS entropy (--no-tfbs)
    no_atac = false           // Disable ATAC entropy (--no-atac)
    skip_pon = false          // Skip PON z-score normalization (--skip-pon)
    skip_target_regions = false  // Force WGS mode (--skip-target-regions)
    
    // E1-only (First Exon) Feature Toggles
    disable_e1_aggregation = false  // Skip E1-only FSC aggregation
    region_mds_e1_only = false      // Run region-MDS on E1 only

    // Logging & Observability
    verbose = false           // Enable verbose/debug logging in tools
    silent = false            // Suppress progress bars in tools (region-mds)
    // Global assay override for EXTRACT. Normally the assay comes per-sample
    // from the samplesheet (meta.assay); this only applies where a module
    // reads it globally. Declared because an undeclared param reads as null
    // today and becomes fatal under nextflow.enable.strict.
    assay = null

    // Output Format Options
    generate_json = true      // Generate unified sample.features.json for ML (default: true)
    // Feature output format: tsv | parquet | both.
    //
    // Defaults to parquet because that is what the downstream consumer
    // (kreview) reads -- and a tsv-only run additionally skips output
    // validation, since the contract describes the Parquet surface. The
    // previous `tsv` default therefore produced a cohort that was invisible
    // downstream and unchecked, silently, because every reader there swallows
    // errors and yields an empty feature dict.
    //
    // Set `tsv` or `both` if you need the text tables; the pipeline warns at
    // start when the selection excludes Parquet.
    output_format = "parquet" // tsv | parquet | both (default changed in 0.9.0)
    strict_validation = false // Fail a sample when its output violates the contract
    // Cohort degeneracy needs more than one sample to mean anything; below
    // this the check reports SKIP rather than PASS, so a small run cannot
    // certify a metric as varying when nothing could have shown otherwise.
    validate_min_samples = 3  // Minimum samples for cross-sample degeneracy checks
    compress_tsv  = false     // Gzip all TSV outputs (.tsv.gz). Only applies for tsv or both.

    // Partition for RETRIED tasks, whose grown time request no longer fits the
    // smallest partition in `--partition`.
    //
    // This cluster runs SLURM with `EnforcePartLimits = ALL`, which means a
    // partition LIST enforces the intersection of the limits while offering the
    // union of the nodes. `-p cmobic_short,cmobic_cpu` is therefore capped at
    // cmobic_short's 3h no matter that cmobic_cpu allows 7 days -- and a 4h
    // retry is not routed to the long partition, it is rejected outright:
    //
    //     allocation failure: Requested time limit is invalid
    //
    // Measured, not assumed: attempt 1 at 2h submitted, attempt 2 at 4h did not,
    // and the only difference between the two job scripts was the time.
    //
    // Leave null and nothing changes. Set it to a partition whose limit covers
    // the grown request -- `--long_partition cmobic_cpu` -- and retries go there
    // instead of being refused.
    long_partition = null

    // nf-core institutional config support
    custom_config_version = 'master'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    monochrome_logs = false
    
    // Test mode inputs (used with -profile test)
    test_data_base = null
}

// Executor Configuration
executor {
    queueSize = 100  // params not resolved here; override via -qs on CLI
}

// Global Process Configuration
process {
    cache = 'lenient'  // GPFS/Spectrum Scale (0x18031977) breaks default inode-based hashing; use name+size only
    cpus = params.threads
    memory = '32 GB'
    time = '24h'
    shell = ['/bin/bash', '-euo', 'pipefail']
    clusterOptions = { "--job-name=nf-${task.process.tokenize(':')[-1]}_${task.tag ?: task.hash}" }

    // Tower/nf-core resource labels
    withLabel:process_low {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }
    withLabel:process_medium {
        cpus = 8
        memory = { 16.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }
    withLabel:process_high {
        cpus = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h  * task.attempt }   // 0.8.2 trace: max realtime was 38m; doubles on retry
    }

    // Resource policy for RUNALL. Sets `queue`, but NOT `errorStrategy` or
    // `maxRetries` -- read this before adding either.
    //
    // The retry policy comes from the institutional config (`-profile iris`),
    // fetched at parse time by the includeConfig below and therefore invisible
    // to `grep` over this repository: maxRetries = 3, retry on anything, then
    // fall back to `ignore`.
    //
    // #57 hardcoded a two-rung ladder here on the belief that nothing retried,
    // and was reverted for overriding that policy -- `withName` outranks a
    // generic `process` block, so it silently cut 3 attempts to 1.
    //
    // The revert also removed its queue selection, on my reasoning that a grown
    // time request would make SLURM pick a partition that could take it. A real
    // 16,552-sample run disproved that: `EnforcePartLimits = ALL` means a
    // partition list enforces the intersection of the limits, so attempt 2's 4h
    // against a list containing a 3h partition was REFUSED, not rerouted. The
    // queue closure below is #57's idea reinstated, for the reason neither the
    // PR nor the revert had identified.
    //
    // What the resource override IS for: iris's withLabel:process_high asks 12 cpus,
    // 72 GB and 16h. Against a 0.8.2 trace whose longest task was 38 minutes,
    // that reserves an order of magnitude more than a sample needs and would
    // gut concurrency at 500 queued jobs. Right-sizing the request is the whole
    // point of this block. The cost is iris's previousTrace-adaptive growth,
    // traded knowingly for a flat multiplier.
    withName: 'KREWLYZER_RUNALL' {
        cpus   = 8
        memory = { 32.GB * task.attempt }
        time   = { 2.h  * task.attempt }

        // Attempt 1 uses whatever --partition says. Later attempts, whose time
        // request has grown past the smallest partition's cap, move to
        // --long_partition if one was given.
        //
        // #57 hardcoded this ladder and was reverted, correctly, because it also
        // overrode errorStrategy and maxRetries and cut the cluster config's 3
        // attempts to 1. But its queue idea was right for a reason neither the
        // PR nor the revert identified: under EnforcePartLimits=ALL a grown
        // request against a partition list is REFUSED, not rerouted. Only the
        // queue is set here; retry policy stays with the institutional config.
        //
        // No partition name appears here -- both come from params, so this is
        // inert unless the operator supplies them.
        queue  = { task.attempt > 1 && params.long_partition
                       ? params.long_partition
                       : params.partition }
    }

    // ---------------------------------------------------------------------
    // Every process the run-all path uses gets an explicit `withName` time.
    //
    // Two reasons, and the first is easy to miss: the `withLabel` blocks above
    // are INERT under `-profile iris`. The institutional config is included
    // after this one and defines the same labels, and at equal selector
    // specificity the later definition wins. Only `withName` outranks it. So a
    // process without a block here runs on iris's numbers, not ours -- SPLIT_MAF
    // ran at 12 GB / 2h, never the 4 GB / 1h `process_low` says.
    //
    // The second is what that cost. iris's `process_single` asks 4h, and under
    // `EnforcePartLimits = ALL` a 4h request against a partition list containing
    // a 3h partition is refused before it queues. KREWLYZER_VALIDATE_COHORT is
    // labelled process_single, so on a completed 16,552-sample run it failed to
    // submit on its FIRST attempt, four times, and was ignored -- the cohort
    // degeneracy report was silently never produced.
    //
    // `--long_partition` does not help here: it only moves *retries*, and this
    // request was already illegal at attempt 1.
    //
    // These are all short, single-threaded jobs. 1-2h fits any reasonable short
    // partition with room to spare; `tests/unit/test_runall_resources.py` fails
    // if a run-all process loses its block.
    withName: 'FILTER_MAF' {
        cpus = 2
        memory = '4 GB'
        time = '1h'
    }
    withName: 'KREWLYZER_VALIDATE_PON' {
        cpus = 2
        memory = '8 GB'
        time = '1h'
    }
    withName: 'KREWLYZER_VALIDATE_COHORT' {
        cpus = 2
        // Reads one fingerprint per sample -- kilobytes each, but 16,552 of
        // them. Measured need is minutes; 2h is headroom, not an estimate.
        memory = '16 GB'
        time = '2h'
    }

    // The MAF split fans IN: one task for the whole cohort. The institutional
    // config's `fail_mode = 'ignore'` is right for per-sample work and wrong
    // here -- when this task failed on a 16,552-sample run, ignoring it meant
    // RUNALL received nothing and the entire cohort produced zero samples, with
    // the run reported as complete.
    //
    // `terminate` so a fan-in failure stops the run in the first ninety seconds
    // rather than after the queue drains into nothing.
    withName: 'SPLIT_MAF' {
        cpus = 2
        memory = '16 GB'
        time = '2h'
        errorStrategy = 'terminate'
    }
}

// Load nf-core institutional configs (e.g. iris, jax, sanger, etc.)
// See: https://github.com/nf-core/configs
//
// A ternary, not a try/catch. Nextflow 26.04 rejects the try/catch idiom
// outright -- "Try-catch blocks cannot be mixed with config statements" -- and
// refuses to parse the file at all, so the pipeline could not start. nf-core
// hit the same wall and moved its own configs to this form, which is why
// nfcore_custom.config and iris.config already parse under 26.
//
// The behaviour change is deliberate and is the better half of this. The old
// `catch` swallowed ANY failure: a transient network blip left the run going
// with no institutional config, which means no `process_single` label, no
// queue closure honouring --isolated/--partition, and no maxRetries -- three
// processes silently falling back to 8 CPU / 32 GB / 24h, a request a short
// partition would refuse at submission. That is a silent change to the resource
// policy of an entire run, reported as one line of stderr nobody reads.
//
// Now the skip happens only when the operator sets NXF_OFFLINE, i.e. when they
// have said they know the configs are unavailable. Everything else is a hard
// parse failure at second zero, which is where a config problem belongs.
includeConfig !System.getenv('NXF_OFFLINE') && params.custom_config_base ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"

// Profiles
profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '--platform linux/amd64 --entrypoint=""'
        singularity.enabled = false
        podman.enabled = false
        shifter.enabled = false
        charliecloud.enabled = false
    }
    
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        docker.enabled = false
    }
    
    slurm {
        process {
            executor = 'slurm'
            queue = 'cmobic_cpu'
            clusterOptions = '' // Add specific options if needed
        }
        singularity {
            enabled = true
            autoMounts = true
            // env('HOME'), not a bare interpolation of it. Nextflow 26 refuses
            // an environment variable referenced directly in config -- "`HOME`
            // is not defined" -- and will not parse the file. Safe on 25 too:
            // iris.config uses env() five times and parses there today.
            // (The old form is not written out here: the guard test greps for
            // the pattern, and a comment quoting it would trip its own check.)
            cacheDir = "${env('HOME')}/.singularity_cache"
        }
        docker.enabled = false
    }
    
    // Test profile for CI - uses stub-run mode
    test {
        params {
            outdir = './test_output'
            genome = 'hg19'
            threads = 2
        }
        process {
            cpus = 2
            memory = '4 GB'
            time = '1h'
        }
    }
    
    // Local development profile (no container, reduced resources for parallelism)
    local {
        docker.enabled = false
        singularity.enabled = false
        
        // Disable trace - macOS without container lacks ps for metrics
        trace.enabled = false
        
        // Lower CPUs per task to allow 2-3 concurrent samples on 12-CPU Mac
        process {
            cpus = 4
            memory = '8 GB'
            time = '24h'
        }
        
        params {
            threads = 4
        }
    }
}

// Execution reports for Tower
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes'
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
    overwrite = true
}

dag {
    enabled = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
    overwrite = true
}

manifest {
    name = 'msk-access/krewlyzer'
    author = 'MSK-ACCESS Team'
    homePage = 'https://github.com/msk-access/krewlyzer'
    description = 'Fragmentomics Feature Extraction Pipeline for cfDNA Analysis'
    mainScript = 'main.nf'
    nextflowVersion = '!>=22.10.1'
    // Must equal src/krewlyzer/__init__.py::__version__. Pinned by
    // tests/unit/test_nextflow_version.py, because the Phase 2 `sed` bumps
    // container tags in the modules and never touched this line -- so 0.9.0
    // shipped with every execution report, trace and Tower entry labelled
    // 0.8.3, which is the provenance confusion the release stamping exists to
    // end.
    version = '0.9.1'
}
